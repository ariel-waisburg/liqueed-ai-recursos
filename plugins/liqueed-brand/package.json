{
  "name": "liqueed-brand",
  "version": "1.0.0",
  "description": "Logo de Liqueed en la barra lateral",
  "type": "module",
  "private": true,
  "license": "MIT",
  "exports": {
    ".": { "import": "./dist/index.js" },
    "./components": { "import": "./dist/components/index.js" }
  },
  "peerDependencies": { "preact": "^10.0.0" },
  "quartz": {
    "name": "liqueed-brand",
